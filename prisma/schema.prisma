generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  password       String
  role           Role      @default(SUPPORT)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  comments       Comment[]
  ticketsCreated Ticket[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Employee {
  id         String   @id @default(cuid())
  name       String
  active     Boolean  @default(true)
  project    String?
  unit       String[] @default([])
  department String?
  position   String?
  createdAt  DateTime @default(now())
  tickets    Ticket[]
}

model Ticket {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement())
  title       String
  description String
  startedAt   DateTime
  endedAt     DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  subjectId   String
  employeeId  String?
  createdById String
  attachments Attachment[]
  comments    Comment[]
  createdBy   User         @relation(fields: [createdById], references: [id])
  subject     Subject      @relation(fields: [subjectId], references: [id])
  employee    Employee?    @relation(fields: [employeeId], references: [id])
}

model Comment {
  id          String       @id @default(cuid())
  content     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ticketId    String
  authorId    String
  attachments Attachment[]
  author      User         @relation(fields: [authorId], references: [id])
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Attachment {
  id        String   @id @default(cuid())
  filename  String
  url       String
  size      Int
  createdAt DateTime @default(now())
  ticketId  String
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model DocumentationTopic {
  id            String                  @id @default(cuid())
  title         String
  content       String                  @default("")
  order         Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  updatedById   String?
  updatedByName String?
  subtopics     DocumentationSubtopic[]
}

model DocumentationSubtopic {
  id            String             @id @default(cuid())
  title         String
  content       String             @default("")
  order         Int                @default(0)
  topicId       String
  topic         DocumentationTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  updatedById   String?
  updatedByName String?
}

model Log {
  id          String     @id @default(cuid())
  action      LogAction
  entityType  LogEntity
  entityId    String
  entityLabel String
  changes     Json?
  actorId     String
  actorName   String
  createdAt   DateTime   @default(now())

  @@index([entityType])
  @@index([createdAt])
}

enum Role {
  ADMIN
  SUPPORT
}

enum LogAction {
  CREATE
  UPDATE
  DELETE
  TOGGLE
}

enum LogEntity {
  TICKET
  EMPLOYEE
  USER
  SUBJECT
  DOCUMENTATION
}
